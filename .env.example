# Safe public client configuration. Never place the Supabase service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Public mobile SDK identifiers. Use Google's demo IDs only in development.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
EXPO_PUBLIC_ADS_TEST_MODE=true

# RevenueCat public platform SDK keys are safe to embed. Webhook secrets are not.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_XXXXXXXXXXXXXXXX
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_XXXXXXXXXXXXXXXX

# Public legal/support pages required by the stores and linked from Settings.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://broke-to-millionaire-legal.roangerbil1.chatgpt.site/privacy
EXPO_PUBLIC_TERMS_URL=https://broke-to-millionaire-legal.roangerbil1.chatgpt.site/terms
EXPO_PUBLIC_SUPPORT_URL=https://broke-to-millionaire-legal.roangerbil1.chatgpt.site/support

# Server-only values belong in Supabase Edge Function secrets, never in this file.
